#!/bin/bash
# Bumps Formula/cliproxyapi.rb to the latest CLIProxyAPI GitHub release and pushes it.
# Once cliproxyapi is installed from this tap, also upgrades it and restarts the service.
# Run every 15 minutes by launchd/com.rakshithbhat03.cliproxyapi-updater.plist.
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1

REPO=router-for-me/CLIProxyAPI
TAP=rakshithbhat03/tap
ARCH=darwin_aarch64
TAP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
FORMULA="$TAP_DIR/Formula/cliproxyapi.rb"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*"; }
formula_version() { sed -nE 's|.*/releases/download/v([^/]+)/.*|\1|p' "$FORMULA"; }

# The /releases/latest redirect names the tag without needing an API token or rate limit.
latest=$(curl -fsSI "https://github.com/$REPO/releases/latest" |
  awk -F/ 'tolower($1) ~ /^location:/ { print $NF }' | tr -d '\r')
latest=${latest#v}
[[ $latest =~ ^[0-9]+(\.[0-9]+)+$ ]] || { log "could not read latest release: '$latest'"; exit 1; }

current=$(formula_version)
if [[ $latest != "$current" ]]; then
  asset="CLIProxyAPI_${latest}_${ARCH}.tar.gz"
  # Assets upload after the release is created; until checksums.txt lists ours, try next run.
  sha=$(curl -fsSL "https://github.com/$REPO/releases/download/v$latest/checksums.txt" 2>/dev/null |
    awk -v a="$asset" '$2 == a { print $1 }') || true
  if [[ ! $sha =~ ^[0-9a-f]{64}$ ]]; then
    log "v$latest: $asset not in checksums.txt yet"
    exit 0
  fi
  git -C "$TAP_DIR" pull -q --rebase origin main || log "pull failed; committing on local main"
  sed -i '' -E \
    -e "s|/download/v[^/]+/CLIProxyAPI_[^_]+_|/download/v$latest/CLIProxyAPI_${latest}_|" \
    -e "s|^(  sha256 )\"[0-9a-f]{64}\"|\1\"$sha\"|" "$FORMULA"
  git -C "$TAP_DIR" commit -qm "cliproxyapi $latest" -- Formula/cliproxyapi.rb
  log "formula bumped $current -> $latest"
fi

# Push anything a previous run couldn't (offline, auth hiccup).
if [[ -n $(git -C "$TAP_DIR" log --oneline origin/main..HEAD 2>/dev/null) ]]; then
  git -C "$TAP_DIR" push -q origin HEAD:main || log "push failed; will retry next run"
fi

# Leave the homebrew-core install (or no install) alone; only manage the one from this tap.
receipt=/opt/homebrew/opt/cliproxyapi/INSTALL_RECEIPT.json
grep -Eq "\"tap\": ?\"$TAP\"" "$receipt" 2>/dev/null || exit 0

# The live config lives in ~/.config so a formula upgrade cannot replace it with the
# stock template (which disables plugins and therefore all provider models). The
# formula symlinks Homebrew's etc path at it; repair that if an older install left a
# plain file behind.
STABLE_CONFIG="$HOME/.config/cliproxyapi/config.yaml"
ETC_CONFIG="/opt/homebrew/etc/cliproxyapi.conf"
config_repaired=0
if [[ -f $STABLE_CONFIG ]]; then
  if [[ ! -L $ETC_CONFIG || $(readlink "$ETC_CONFIG") != "$STABLE_CONFIG" ]]; then
    if [[ -f $ETC_CONFIG ]] && ! cmp -s "$STABLE_CONFIG" "$ETC_CONFIG"; then
      cp -p "$ETC_CONFIG" "$ETC_CONFIG.bak-$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
    fi
    rm -f "$ETC_CONFIG"
    ln -s "$STABLE_CONFIG" "$ETC_CONFIG"
    config_repaired=1
    log "restored $ETC_CONFIG -> $STABLE_CONFIG"
  fi
fi

# CLIProxyAPI's /healthz can answer before its plugin host and model registry
# finish loading. Treat the proxy as ready only when /v1/models returns models.
service_started() {
  brew services list 2>/dev/null | awk '$1 == "cliproxyapi" && $2 == "started" { found = 1 } END { exit found ? 0 : 1 }'
}

opencode_plugin_enabled() {
  [[ -f $STABLE_CONFIG ]] || return 1
  [[ $(/usr/bin/ruby -ryaml -e '
    c = YAML.load_file(ARGV[0]) || {}
    configs = ((c["plugins"] || {})["configs"] || {})
    enabled = %w[opencode-go-cliproxyapi cpa-opencode-go].any? do |id|
      (configs[id] || {})["enabled"] == true
    end
    print(enabled ? "1" : "0")
  ' "$STABLE_CONFIG" 2>/dev/null) == 1 ]]
}

proxy_models_ready() {
  local body
  body=$(curl -fsS --max-time 2 "http://127.0.0.1:8317/v1/models" 2>/dev/null) || return 1
  grep -q '"id"' <<<"$body" || return 1
  if [[ $plugin_check == 1 ]]; then
    grep -q '"opencode-go/' <<<"$body" || return 1
  fi
  return 0
}

wait_for_models() {
  local tries=${1:-45} i
  for ((i = 0; i < tries; i++)); do
    if proxy_models_ready; then
      return 0
    fi
    sleep 1
  done
  return 1
}

stop_and_wait() {
  brew services stop cliproxyapi >/dev/null 2>&1 || true
  local i
  for ((i = 0; i < 30; i++)); do
    pgrep -f 'cli-proxy-api -config' >/dev/null || break
    sleep 1
  done
}

restart_service() {
  stop_and_wait
  brew services start cliproxyapi >/dev/null 2>&1 || true
}

plugin_check=0
if opencode_plugin_enabled; then
  plugin_check=1
fi

target=$(formula_version)
installed=$(brew list --versions cliproxyapi | awk '{ print $NF }')
if [[ $installed != "$target" ]]; then
  # Stop first and wait for the old process to exit. The plugin host unloads
  # dynamic libraries during shutdown; starting the new binary too early can
  # leave the opencode-go plugin loaded but unregistered (zero models).
  stop_and_wait
  if ! brew upgrade "$TAP/cliproxyapi"; then
    log "upgrade failed; restarting the installed version"
    brew services start cliproxyapi >/dev/null 2>&1 || true
    exit 1
  fi
  brew services start cliproxyapi >/dev/null 2>&1 || true
  log "upgraded $installed -> $target and restarted the service"
elif [[ $config_repaired == 1 ]]; then
  restart_service
  log "restarted the service to pick up the restored config"
fi

# Verify the proxy actually published models. A restart can race with plugin
# registration; one clean retry is enough to recover in practice.
if service_started && [[ $plugin_check == 1 ]]; then
  if ! wait_for_models 45; then
    log "proxy is up but opencode-go models are missing; restarting once"
    restart_service
    if wait_for_models 45; then
      log "proxy recovered after a second restart"
    else
      log "ERROR: opencode-go models are still missing; check $STABLE_CONFIG and the proxy logs"
    fi
  fi
fi
